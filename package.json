{
  "name": "@opsle/affected-verification",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "affected-verification": "./bin/affected-verification.js"
  },
  "exports": "./src/index.js",
  "scripts": {
    "check": "node --check src/*.js && node --check bin/*.js && node --check tools/*.js && node --check tests/*.js",
    "test": "node --test",
    "conformance": "node ./tools/conformance.js",
    "determinism": "node --test --test-name-pattern='deterministic|stable|identical'",
    "verify": "npm run check && npm test && npm run conformance && npm run determinism",
    "benchmark:av-exp-001": "node benchmark/av-exp-001/run.mjs all"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0"
}
